# Fictional LAN: 192.168.15.10/24; router 192.168.15.1. Loopback is the safe local default.
BLASTER_BIND_ADDRESS=127.0.0.1
BLASTER_HTTPS_PORT=8443
# Operator-supplied directory OUTSIDE this repository. No certificates are shipped.
BLASTER_TLS_DIR=/absolute/path/outside-repository/tls
NGINX_IMAGE=nginx:1.30.6
APISIX_IMAGE=apache/apisix:3.19.0-debian
VAULT_IMAGE=hashicorp/vault:2.0.3
# Optional local Vault administration port; never published on the LAN by this file.
VAULT_LOCAL_PORT=18200
